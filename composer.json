{
    "name": "codavaio/copyright-badge",
    "description": "A small footer copyright line with a linked logo, in Arabic and English, as a Laravel Blade component and a plain PHP renderer.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "blade", "copyright", "footer", "badge", "arabic", "rtl"],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "illuminate/view": "Needed for the <x-copyright-badge /> Blade component."
    },
    "autoload": {
        "psr-4": {
            "Codava\\CopyrightBadge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codava\\CopyrightBadge\\Tests\\": "tests/php/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codava\\CopyrightBadge\\CopyrightBadgeServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
